-- SKY
heading("Sky","VISUAL PRESETS")

local function sky(name)
    local a=Lighting:FindFirstChild("UV_Atmosphere")
    if not a then
        a=Instance.new("Atmosphere")
        a.Name="UV_Atmosphere"
        a.Parent=Lighting
    end

    local presets={
        Galaxy={0,Color3.fromRGB(110,75,220),Color3.fromRGB(35,15,90)},
        ["Full Moon"]={0,Color3.fromRGB(175,190,225),Color3.fromRGB(45,55,100)},
        Winter={13,Color3.fromRGB(195,225,255),Color3.fromRGB(150,180,220)},
        Sunset={18,Color3.fromRGB(255,145,100),Color3.fromRGB(110,45,90)},
        Space={0,Color3.fromRGB(65,65,110),Color3.fromRGB(15,10,35)},
        Night={1,Color3.fromRGB(100,110,160),Color3.fromRGB(25,30,60)},
        Day={14,Color3.fromRGB(255,255,255),Color3.fromRGB(180,190,200)}
    }

    local data=presets[name]
    if data then
        Lighting.ClockTime=data[1]
        a.Color=data[2]
        a.Decay=data[3]
        a.Density=.3
        a.Haze=1
    end
end

for _,name in ipairs({"Galaxy","Full Moon","Winter","Sunset","Space","Night","Day"}) do
    button("Sky","Apply "..name,function()
        sky(name)
    end)
end

-- AVATAR VISUALS
heading("Avatar","LOCAL CHARACTER VISUALS")

local saved={}
local function getCharacter()
    return player.Character
end

local function headless(on)
    local char=getCharacter()
    if not char then return end
    local head=char:FindFirstChild("Head")
    if not head then return end

    if on then
        saved.HeadTransparency=head.Transparency
        head.Transparency=1
        local face=head:FindFirstChildWhichIsA("Decal")
        if face then
            saved.FaceTransparency=face.Transparency
            face.Transparency=1
        end
    else
        head.Transparency=saved.HeadTransparency or 0
        local face=head:FindFirstChildWhichIsA("Decal")
        if face then
            face.Transparency=saved.FaceTransparency or 0
        end
    end
end

local korblox=false
local function korbloxVisual(on)
    local char=getCharacter()
    if not char then return end
    local leg=char:FindFirstChild("RightLowerLeg")
        or char:FindFirstChild("Right Leg")

    if not leg then return end

    if on then
        saved.LegTransparency=leg.Transparency
        leg.Transparency=1
    else
        leg.Transparency=saved.LegTransparency or 0
    end
end

toggle("Avatar","Headless visual",headless)
toggle("Avatar","Korblox leg visual",korbloxVisual)

button("Avatar","Reset avatar visuals",function()
    headless(false)
    korbloxVisual(false)
end)

