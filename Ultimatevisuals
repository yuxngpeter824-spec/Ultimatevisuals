local function button(page,title,callback)
    local b=make("TextButton",{
        Size=UDim2.new(1,-5,0,38),
        BackgroundColor3=panel,
        Text=title,
        TextColor3=white,
        TextSize=13,
        Font=Enum.Font.GothamSemibold
    },pages[page])
    round(b)
    b.MouseButton1Click:Connect(callback)
    return b
end

local function toggle(page,title,callback)
    local state=false
    local b
    b=button(page,title.." : OFF",function()
        state=not state
        b.Text=title.." : "..(state and "ON" or "OFF")
        b.BackgroundColor3=state and purple or panel
        callback(state)
    end)
end

local function heading(page,title)
    local l=make("TextLabel",{
        Size=UDim2.new(1,-5,0,28),
        BackgroundTransparency=1,
        Text=title,
        TextColor3=purple,
        TextSize=14,
        Font=Enum.Font.GothamBold,
        TextXAlignment=Enum.TextXAlignment.Left
    },pages[page])
end

